# ==========================================
# Verinaliz Mobile App — Environment Configuration
# ==========================================

# Base URL for the Verinaliz backend API service
# During local development, use your computer's local IP (e.g. http://192.168.1.50:3000)
# In production, use your deployed Railway / Cloud API URL:
EXPO_PUBLIC_API_URL=https://your-backend-api.example.com

# Set these for release builds and when exporting the legal templates.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_DATA_CONTROLLER=
EXPO_PUBLIC_PUBLISHER_NAME=
